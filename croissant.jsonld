  "@id": "social-media-sentiment-biocypher-adapter",
  "name": "Social Media Sentiment BioCypher Adapter",
  "description": "A BioCypher adapter that transforms a social media sentiment CSV dataset into a Neo4j-compatible knowledge graph. It creates User, SocialMediaPost, Emotion, and Hashtag nodes, connected through POSTED, EXPRESSES, and HAS_TAG relationships. The adapter normalizes values, handles duplicate records, and preserves relevant source information.",
  "version": "0.1.0",
  "license": "https://opensource.org/licenses/MIT",
  "codeRepository": "https://github.com/yasfazl/social-media-sentiment-biocypher-adapter",
  "creator": [
    {
      "@type": "Person",
      "name": "Yasamin Fazeli",
      "affiliation": "Heidelberg University",
      "url": "https://github.com/yasfazl"
    }
  ],
  "keywords": [
    "BioCypher",
    "Neo4j",
    "knowledge graph",
    "social media",
    "sentiment analysis",
    "CSV"
  ],
